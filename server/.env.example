# Identifiants NATS: ne jamais les mettre dans index.html ni dans Git.
NATS_USERNAME=remplacer_par_le_login
NATS_PASSWORD=remplacer_par_le_mot_de_passe

# URL du briefing NATS Aerodrome PIB.
NATS_BRIEFING_URL=https://nats-uk.ead-it.com/fwf-nats/restricted/user/ino/brief_aerodrome.faces?menuId=C920E9BB76441A9AE05341741DC25BDD
NATS_FAVORITE_NAME=PELICANDROMES

# Serveur NAS.
PORT=8080
DATA_DIR=/data
ALLOWED_ORIGINS=*

# Laisser true sur NAS. Mettre false seulement pour debug avec une interface graphique.
NATS_HEADLESS=true

